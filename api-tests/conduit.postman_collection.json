  "info": {
    "_postman_id": "1a7575a6-ff83-4ab3-9a9b-c1468d7f972b",
    "name": "Conduit - Pruebas de API",
    "description": "Pruebas de API (no unitarias) del backend de Conduit. Encadena el flujo de negocio completo: registro, inicio de sesión, publicación, edición, seguimiento, feed, favoritos, comentarios y eliminación. Se ejecuta con Newman en el pipeline.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Autenticación",
      "item": [
        {
          "name": "01 Registrar usuario A",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Identificador único por ejecución para no chocar con datos de corridas anteriores",
                  "const runId = Date.now().toString(36);",
                  "pm.collectionVariables.set(\"runId\", runId);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const userSchema = {",
                  "  type: \"object\", required: [\"user\"],",
                  "  properties: { user: { type: \"object\", required: [\"username\", \"token\"],",
                  "    properties: { username: { type: \"string\" }, token: { type: \"string\" } },",
                  "    not: { required: [\"password\"] } } }",
                  "};",
                  "pm.test(\"Código 201\", () => pm.response.to.have.status(201));",
                  "pm.test(\"Esquema de usuario sin contraseña (RNF-04)\", () => pm.response.to.have.jsonSchema(userSchema));",
                  "pm.test(\"Usuario creado con el nombre enviado\", () => {",
                  "  pm.expect(pm.response.json().user.username).to.eql(\"qa_a_\" + pm.collectionVariables.get(\"runId\"));",
                  "});",
                  "pm.test(\"Tiempo de respuesta menor a 800 ms\", () => pm.expect(pm.response.responseTime).to.be.below(800));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/users",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "users"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"user\": {\n    \"username\": \"qa_a_{{runId}}\",\n    \"email\": \"qa_a_{{runId}}@test.com\",\n    \"password\": \"Clave1234\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
