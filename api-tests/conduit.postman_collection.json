              "script": {
                "type": "text/javascript",
                "exec": [
                  "const userSchema = {",
                  "  type: \"object\", required: [\"user\"],",
                  "  properties: { user: { type: \"object\", required: [\"username\", \"token\"],",
                  "    properties: { username: { type: \"string\" }, token: { type: \"string\" } },",
                  "    not: { required: [\"password\"] } } }",
                  "};",
                  "pm.test(\"Código 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Esquema de usuario\", () => pm.response.to.have.jsonSchema(userSchema));",
                  "const token = pm.response.json().user.token;",
                  "pm.test(\"Token JWT con tres partes\", () => pm.expect(token.split(\".\")).to.have.lengthOf(3));",
                  "pm.collectionVariables.set(\"tokenA\", token);"
                ]
