        {
          "name": "09 Crear artículo (A)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const articleSchema = {",
                  "  type: \"object\", required: [\"article\"],",
                  "  properties: { article: { type: \"object\",",
                  "    required: [\"slug\", \"title\", \"description\", \"body\", \"tagList\", \"author\", \"favorited\", \"favoritesCount\"],",
                  "    properties: { slug: { type: \"string\" }, tagList: { type: \"array\", items: { type: \"string\" } },",
                  "      favorited: { type: \"boolean\" }, favoritesCount: { type: \"integer\" },",
                  "      author: { type: \"object\", required: [\"username\"] } } } }",
                  "};",
                  "pm.test(\"Código 201\", () => pm.response.to.have.status(201));",
                  "pm.test(\"Esquema de artículo\", () => pm.response.to.have.jsonSchema(articleSchema));",
                  "const a = pm.response.json().article;",
                  "pm.test(\"Slug generado desde el título (RF-07)\", () => pm.expect(a.slug).to.eql(\"articulo-qa-\" + pm.collectionVariables.get(\"runId\")));",
                  "pm.test(\"Autor es el usuario A\", () => pm.expect(a.author.username).to.eql(\"qa_a_\" + pm.collectionVariables.get(\"runId\")));",
                  "pm.collectionVariables.set(\"slug\", a.slug);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Token {{tokenA}}"
